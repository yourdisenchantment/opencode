            "resource": "pip3 install *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "pip3 uninstall *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm install -g *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm uninstall -g *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm i -g *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm i --global *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm install --global *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "npm install * -g*",
