            "resource": "sh *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "bash *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "zsh *",
            "effect": "deny"
        },
        {
