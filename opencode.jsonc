            "action": "shell",
            "resource": "git config -l *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git tag -l *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git tag --list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git worktree list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git submodule status *",
            "effect": "allow",
        },
        {
            "action": "shell",
            "resource": "git symbolic-ref HEAD",
            "effect": "allow",
        },
        {
            "action": "shell",
            "resource": "git symbolic-ref --short HEAD",
            "effect": "allow",
        },
        {
            "action": "shell",
            "resource": "apt-get list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "apt list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "apt-cache search *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "apt-cache show *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "brew list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "brew info *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "brew search *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pip list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pip show *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pip3 list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pip3 show *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "npm ls -g *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "npm list -g *",
            "effect": "allow"
        },
        // Secret file patterns, one set for every action (read, edit, shell, ...).
        // Kept last on purpose: last match wins, so these override the broad allows
        // above. Shell resources are command text, so only commands that end in such
        // a path (e.g. `cat .env`) match.
        {
            "action": "*",
            "resource": "*/opencode/service.json",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*.env",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*.env.*",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*env.local",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*.pem",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*.key",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*id_rsa*",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*id_ed25519*",
            "effect": "deny"
        },
        {
            "action": "*",
            "resource": "*.netrc",
            "effect": "deny"
        },
        // Example env files are the one exception, and only for the file tools: an
        // allow with action `*` would also lift the shell deny rules (e.g. `rm *`).
        {
            "action": "read",
            "resource": "*.env.example",
            "effect": "allow"
        },
        {
            "action": "edit",
            "resource": "*.env.example",
            "effect": "allow"
        },
    ],
    // Was flat V1 `mcp`: servers now nested under `mcp.servers`,
    // V1 `enabled: true` dropped (enabled is the default).
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "headers": {
                    "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
                },
            },
            "keenable": {
                "type": "remote",
                "url": "https://api.keenable.ai/mcp",
                "headers": {
                    "X-API-Key": "{env:KEENABLE_API_KEY}",
                },
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@1.12.0",
                    "--no-usage-statistics",
                    "--isolated",
                    "--headless",
                    "--screenshotFormat=jpeg",
                    "--screenshotQuality=80",
                    "--screenshotMaxWidth=1280",
                    "--screenshotMaxHeight=800",
                    "--redactNetworkHeaders",
                ],
            },
        },
    },
}
