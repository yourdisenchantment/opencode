            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git apply *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git am *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git init *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git gc *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git prune *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git filter-branch *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git reflog expire *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git reflog delete *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git remote prune *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git remote update *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git remote set-head *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git worktree remove *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git worktree prune *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git worktree move *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git submodule update *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git symbolic-ref *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git status *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git log *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git diff *",
            "effect": "allow"
