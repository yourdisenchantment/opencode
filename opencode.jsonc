            "resource": "fish *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "apt-get install *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "apt-get remove *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "apt-get purge *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "apt install *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "apt remove *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "brew install *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "brew uninstall *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "pip install *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "pip uninstall *",
            "effect": "deny"
