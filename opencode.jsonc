            "resource": "git ls-files *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git ls-remote *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git fetch *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git rev-parse *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git branch -a *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git branch -r *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git branch --list *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git branch -vv *",
            "effect": "allow"
        },
