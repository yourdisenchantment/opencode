// ~/.config/opencode/opencode.jsonc
// Native V2 configuration, migrated from V1 on 2026-10-08, trimmed 2026-10-16.
// Only non-default values are set; everything else follows opencode defaults.
// See https://opencode.ai/config.json for all keys.
{
    "$schema": "https://opencode.ai/config.json",
    // "username": "",
    // "model": "",
    // V1 `small_model` has no direct equivalent: use per-agent model instead.
    // "shell": "",
    // V1 `logLevel` is unsupported in V2: use OPENCODE_LOG_LEVEL env var instead.
    // Tool-independent rules shared with other agents: CORE.md (general, Russian)
    // and RULES.md (coding layer). See AGENTS.md for the split.
    // Absolute on purpose: a relative path is searched upward from the project.
    "instructions": [
        "~/.config/opencode/CORE.md",
        "~/.config/opencode/RULES.md"
    ],
    // Experimental features (2026-10-31, opencode 2.2.3): all of these are
    // now supported releases. media_blob required v2.1.4+ (works here).
    "experimental": {
        "todo": true,
        "portable_shell_scanner": true,
        "background_compaction": true,
        "media_blob": true,
    },
    // Was V1 `reserved`; V1 `prune` has no V2 equivalent (checkpoint-based now).
    "compaction": {
        "auto": true,
        "buffer": 10000,
    },
    // The global `permissions` below are appended AFTER the built-in rules of every
    // agent and the last match wins, so the broad allows (edit, subagent, question,
    // todowrite) would lift the built-in limits of plan / explore / general. These
    // entries are appended after the global list and put the limits back.
    "agents": {
        "plan": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "edit",
                    "resource": "~/.opencode/plan/*",
                    "effect": "allow"
                },
            ],
        },
        "explore": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "question",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "todowrite",
                    "resource": "*",
                    "effect": "deny"
                },
            ],
        },
        "general": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "question",
                    "resource": "*",
                    "effect": "deny"
                },
            ],
        },
    },
    // V1 `permission` object rewritten as an ordered V2 `permissions` array.
    // V1 actions renamed: `bash` -> `shell`, `task` -> `subagent`.
    // Rule order within each former group is preserved, so last-match-wins
    // keeps the V1 semantics (broad allow first, specific deny/allow after).
    // V1 `experimental.continue_loop_on_deny` has no V2 equivalent, dropped.
    "permissions": [
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        // Secret file patterns for every action are in the block at the end of this
        // list. `~/` paths stay per action here: only read/edit expand `~`.
        {
            "action": "read",
            "resource": "~/.ssh/*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "~/.aws/*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "~/.gcp/*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "~/.gnupg/*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "~/.netrc",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "edit",
            "resource": "~/.ssh/*",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "~/.aws/*",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "~/.gcp/*",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "~/.gnupg/*",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "~/.netrc",
            "effect": "deny"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "list",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "subagent",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "todowrite",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "rm *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "rmdir *",
            "effect": "deny"
        },
        {
